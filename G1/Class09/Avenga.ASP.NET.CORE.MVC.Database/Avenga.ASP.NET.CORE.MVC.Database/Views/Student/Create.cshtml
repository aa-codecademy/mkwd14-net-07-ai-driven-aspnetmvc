@using Microsoft.AspNetCore.Mvc.Rendering
@model Student

<h1>Create Student</h1>

<form asp-action="Create" method="post">

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth"></label>
        <input asp-for="DateOfBirth"
               type="date"
               class="form-control" />
        <span asp-validation-for="DateOfBirth"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <div>
            <label asp-for="ActiveCourseId">Active Course</label>

            <select asp-for="ActiveCourseId"
                    asp-items="@(ViewBag.Courses as SelectList)">
                <option value="">Select course</option>
            </select>

            <span asp-validation-for="ActiveCourseId"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save
        </button>
</form>