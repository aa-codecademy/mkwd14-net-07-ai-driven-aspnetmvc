@model List<StudentViewModel>

<p class="mt-3">Today's date: @ViewData["CurrentDate"]</p>

<h2>@ViewBag.WelcomeMessage</h2>

<p>@TempData["StudentCreated"]</p>
<div class="container mt-5">
    <table class="table table-borded table-striped">
        <thead class="text-warning bg-white">
            <tr>
                <th>Full name </th>
                <th>Age </th>
                <th>Active Course </th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (StudentViewModel student in Model)
            {
                <tr>
                    <td>@student.Fullname</td>
                    <td>@student.Age</td>
                    <td>@student.ActiveCourseName</td>
                    <td>
                        <a asp-controller="Student" asp-action="GetStudentById" asp-route-studentId="@student.Id" class="btn btn-outline-danger">Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
